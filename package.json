{
  "name": "ptal",
  "displayName": "PTAL — PR Review Comments in Your Editor",
  "description": "Handle every PR review comment without leaving your code — then ask for another look.",
  "version": "0.0.1",
  "publisher": "jihwank",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/jihwanK/ptal.git"
  },
  "engines": {
    "vscode": "^1.90.0"
  },
  "categories": [
    "Other"
  ],
  "activationEvents": [
    "workspaceContains:.git",
    "onStartupFinished"
  ],
  "main": "./dist/extension.js",
  "contributes": {
    "commands": [
      {
        "command": "ptal.refresh",
        "title": "PTAL: Refresh Review Comments"
      },
      {
        "command": "ptal.nextUnresolved",
        "title": "PTAL: Go to Next Unresolved Comment"
      },
      {
        "command": "ptal.reply",
        "title": "Reply"
      },
      {
        "command": "ptal.resolve",
        "title": "Resolve Conversation",
        "icon": "$(check)"
      },
      {
        "command": "ptal.unresolve",
        "title": "Unresolve Conversation",
        "icon": "$(debug-restart)"
      }
    ],
    "menus": {
      "commandPalette": [
        { "command": "ptal.reply", "when": "false" },
        { "command": "ptal.resolve", "when": "false" },
        { "command": "ptal.unresolve", "when": "false" }
      ],
      "comments/commentThread/context": [
        {
          "command": "ptal.reply",
          "group": "inline",
          "when": "commentController == ptal"
        }
      ],
      "comments/commentThread/title": [
        {
          "command": "ptal.resolve",
          "group": "navigation",
          "when": "commentController == ptal && commentThread == unresolved"
        },
        {
          "command": "ptal.unresolve",
          "group": "navigation",
          "when": "commentController == ptal && commentThread == resolved"
        }
      ]
    }
  },
  "scripts": {
    "build": "node esbuild.mjs",
    "watch": "node esbuild.mjs --watch",
    "typecheck": "tsc --noEmit",
    "vscode:prepublish": "node esbuild.mjs",
    "test": "vitest run"
  },
  "devDependencies": {
    "@types/node": "^20.14.0",
    "@types/vscode": "^1.90.0",
    "esbuild": "^0.24.0",
    "typescript": "^5.5.0",
    "vitest": "^2.1.9"
  }
}
